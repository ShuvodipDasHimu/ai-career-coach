ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Auth.js
AUTH_SECRET=            # generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_URL=http://localhost:3000   # only needed locally / if not on Vercel

# Google  (callback: {origin}/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LinkedIn (callback: {origin}/api/auth/callback/linkedin)
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# AI provider: set GEMINI_API_KEY to use Gemini (free tier at aistudio.google.com/apikey).
# If it's unset, the app uses ANTHROPIC_API_KEY instead.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
